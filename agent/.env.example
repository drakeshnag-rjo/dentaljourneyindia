# === Twenty CRM ===
CRM_BASE_URL=http://192.168.1.217:3000
CRM_API_TOKEN=your_twenty_crm_api_token_here

# === Stalwart SMTP ===
SMTP_HOST=192.168.1.207
SMTP_PORT=587
SMTP_USER=hello
SMTP_PASS=your_stalwart_password_here
SMTP_FROM=hello@dentaljourneyindia.org
SMTP_FROM_NAME=DentalJourneyIndia

# === Admin / Digest ===
ADMIN_EMAIL=your_personal_email@gmail.com
ADMIN_NAME=Rakesh

# === Agent Settings ===
# Set to 'true' to log emails without sending
DRY_RUN=false
# Max emails per hour (warm-up: start low, increase weekly)
MAX_EMAILS_PER_HOUR=5
# Timezone for cron schedules
TZ=Asia/Kolkata

# === Unsubscribe / Suppression ===
# HMAC secret for unsubscribe links (MUST match the bot's UNSUB_SECRET)
UNSUB_SECRET=generate-a-long-random-string
# Suppression list shared with the bot (unsubscribed emails)
SUPPRESSION_FILE=/var/www/dentaljourneyindia-shared/suppression.json
# Public base URL used in unsubscribe links
PUBLIC_BASE_URL=https://dentaljourneyindia.org
# Persistent agent state (follow-up dedup + clinic outreach progress)
STATE_FILE=./data/state.json
# Set to 'true' ONLY for a local test SMTP relay without valid certs
SMTP_TLS_INSECURE=false
